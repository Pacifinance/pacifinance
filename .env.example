# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (REST API, used for cache + registration anti-replay guard)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (registration captcha)
TURNSTILE_SECRET_KEY=

# CoinGecko API key (demo tier)
CG_KEY=

# App-level encryption key for sensitive free-text fields (currently expenses.notes).
# 32 random bytes, base64: generate with `openssl rand -base64 32`. Lives only in
# Doppler/Vercel env vars, never in the DB or the repo. Losing/rotating it makes
# previously-encrypted notes unreadable unless the old key is kept for decryption.
DB_ENCRYPTION_KEY=

# Shared secret checked against the Authorization header on /api/cron/* endpoints.
# Set the same value here and as a Vercel env var: Vercel automatically sends it
# as "Authorization: Bearer $CRON_SECRET" when invoking Vercel Cron Jobs.
CRON_SECRET=

# Local dev only (ignored on Vercel, which sets VERCEL=1 and PORT automatically)
PORT=3000
NODE_ENV=development
