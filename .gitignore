# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
html/html.meta.json.gz

# production
/build
server/build
aStableBuild/

# migration output and DB backups (contain bcrypt hashes and user data — never commit)
migration-final.sql
migration-encryption-key.txt
backupMongo/

# Supabase CLI local project cache (created by `supabase link`/`db dump`) —
# machine-local state, not part of the schema
supabase/.temp/

# private notes: business strategy, ops runbooks with secret names, informal
# personal scratchpad — never meant for the public repo (see docs cleanup)
.internal/

# Claude Code local/per-machine state — settings.json (shared) stays tracked,
# but personal overrides and session locks should never land in the repo.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# misc
server/scripts
.DS_Store
*.sh
!docker/**/*.sh
!scripts/*.sh
*.backup
*.bak
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.conf
!docker/**/*.conf

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.replit

/attached_assets
attached_assets/

docker-compose.override.yml

# Supabase's own self-hosting stack, cloned on demand by
# scripts/self-host-local.sh - third-party code, never ours to track.
.selfhost-supabase/
.selfhost-supabase.src/

pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*
!.env.example
!.env.development.example
