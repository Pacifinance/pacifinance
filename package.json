{
  "name": "pacifinance.com",
  "subdomain": "",
  "domains": [
    "pacifinance.com",
    "www.pacifinance.com"
  ],
  "version": "0.10.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/pacifinance/pacifinance"
  },
  "homepage": "https://www.pacifinance.com",
  "bugs": {
    "url": "https://github.com/pacifinance/pacifinance/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/src/index.ts",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "version:set": "node scripts/setVersion.js",
    "version:bump:patch": "node scripts/bumpVersion.js patch",
    "version:bump:minor": "node scripts/bumpVersion.js minor",
    "version:bump:major": "node scripts/bumpVersion.js major",
    "version:0.9.9": "node scripts/setVersion.js 0.9.9",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:utils": "vitest run src/__tests__/utils/",
    "test:contexts": "vitest run src/__tests__/contexts/",
    "test:components": "vitest run src/__tests__/components/",
    "test:services": "vitest run src/__tests__/services/",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:di": "vitest run src/__tests__/services/ src/__tests__/integration/diCoverage.test.js",
    "roadmap": "node scripts/generateRoadmap.js",
    "sitemap": "node scripts/generateSitemap.js",
    "prebuild": "node scripts/generateRoadmap.js && node scripts/generateSitemap.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.8",
    "@supabase/supabase-js": "^2.112.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.19.0",
    "cookie-parser": "^1.4.7",
    "dom-to-image": "^2.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-calendar": "^6.0.1",
    "react-csv": "^2.2.2",
    "react-dom": "^19.2.8",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.7.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "serverless-http": "^3.2.0",
    "styled-components": "^6.5.1",
    "terser": "^5.49.2",
    "typescript": "^5.9.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vercel/node": "^5.9.8",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.0.18",
    "babel-plugin-styled-components": "^2.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "react-side-effect": {
      "react": "$react"
    },
    "js-yaml": "^4.3.1",
    "undici": "^5.29.0",
    "uuid": "^11.1.1"
  }
