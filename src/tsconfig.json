{
  "compilerOptions": {
    /* Language / environment */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* Interop with existing JS/JSX codebase */
    "allowJs": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Emit — this project uses Vite for bundling, TS only type-checks */
    "noEmit": true,

    /* Strictness: start permissive. Tighten later incrementally. */
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* Quality of life */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,

    /* Path aliases — mirrored in vite.config.mjs via vite-tsconfig-paths */
    "paths": {
      "@/*":           ["./*"],
      "@components/*": ["./components/*"],
      "@sections/*":   ["./sections/*"],
      "@pages/*":      ["./pages/*"],
      "@hooks/*":      ["./hooks/*"],
      "@contexts/*":   ["./contexts/*"],
      "@services/*":   ["./services/*"],
      "@utils/*":      ["./utils/*"],
      "@data/*":       ["./data/*"],
      "@constants/*":  ["./constants/*"],
      "@types/*":      ["./types/*"],
      "@i18n/*":       ["./i18n/*"],
      "@styles/*":     ["./styles/*"],
      "@assets/*":     ["./assets/*"]
    }
  },
  "include": [
    ".",
    "../index.html"
  ],
  "exclude": [
    "../node_modules",
    "../build",
    "../aStableBuild",
    "__tests__"
  ]
}

