{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/stats/:match*", "destination": "https://eu.umami.is/:match*" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/refresh-user-averages", "schedule": "0 3 1 * *" },
    { "path": "/api/cron/delete-users", "schedule": "0 2 * * *" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
