{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/refresh-user-averages", "schedule": "0 3 * * *" },
    { "path": "/api/cron/delete-users", "schedule": "0 2 * * *" }
  ]
}
